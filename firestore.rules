rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 200)) &&
             data.themeMode in ['dark', 'light'] &&
             data.defaultStartupMode in ['text', 'continuous', 'push_to_talk'] &&
             data.voiceLanguage in ['en', 'hi', 'mr', 'auto'] &&
             data.responseStyle in ['friendly', 'calm', 'excited', 'empathetic', 'professional'] &&
             data.waveformAnimationsEnabled is bool &&
             data.autoMemoryRecallEnabled is bool &&
             data.voiceResponsesEnabled is bool &&
             (!('preferredModel' in data) || data.preferredModel in ['gemini-3.8-flash', 'gemini-3.5-flash-lite', 'gemini-4-argon']);
    }

    function isValidChatMessage(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.sessionId is string && data.sessionId.size() >= 1 && data.sessionId.size() <= 128 &&
             data.role in ['user', 'assistant'] &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 20000 &&
             data.latencyMs is int && data.latencyMs >= 0 && data.latencyMs <= 600000;
    }

    function isValidMemoryFact(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.category in ['general', 'user_profile', 'preferences', 'personal_instructions', 'important_facts', 'work'] &&
             data.key is string && data.key.size() >= 1 && data.key.size() <= 160 &&
             data.value is string && data.value.size() >= 1 && data.value.size() <= 4000;
    }

    function isValidPersonalTask(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 4000 &&
             data.priority in ['low', 'medium', 'high', 'urgent'] &&
             data.status in ['pending', 'in_progress', 'completed', 'cancelled'] &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
             data.dueDateLabel is string && data.dueDateLabel.size() <= 80;
    }

    function isValidReminderItem(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.triggerLabel is string && data.triggerLabel.size() >= 1 && data.triggerLabel.size() <= 100 &&
             data.recurringRule in ['none', 'daily', 'weekdays', 'weekly', 'monthly'] &&
             data.status in ['pending', 'triggered', 'snoozed', 'cancelled'];
    }

    function isValidPersonalNote(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 12000 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
             data.pinned is bool;
    }

    function isValidAutonomousRun(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.goal is string && data.goal.size() >= 1 && data.goal.size() <= 1000 &&
             data.status in ['pending', 'running', 'awaiting_confirmation', 'completed', 'failed', 'cancelled'] &&
             data.stepsSummary is string && data.stepsSummary.size() <= 8000 &&
             data.stepsCompleted is int && data.stepsCompleted >= 0 && data.stepsCompleted <= 50 &&
             data.stepsTotal is int && data.stepsTotal >= 0 && data.stepsTotal <= 50;
    }

    function isValidPermissionRule(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.permissionKey is string && data.permissionKey.size() >= 1 && data.permissionKey.size() <= 100 &&
             data.decision in ['allow', 'confirm', 'deny'] &&
             data.lifetime in ['one_time', 'session', 'time_limited', 'persistent'] &&
             data.reason is string && data.reason.size() <= 500;
    }

    function isValidAuditEntry(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.permissionKey is string && data.permissionKey.size() >= 1 && data.permissionKey.size() <= 100 &&
             data.decision in ['allow', 'confirm', 'deny'] &&
             data.reason is string && data.reason.size() <= 500;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == userId &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'themeMode', 'defaultStartupMode',
                         'voiceLanguage', 'responseStyle', 'waveformAnimationsEnabled',
                         'autoMemoryRecallEnabled', 'voiceResponsesEnabled', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'email', 'themeMode', 'defaultStartupMode',
                         'voiceLanguage', 'responseStyle', 'waveformAnimationsEnabled',
                         'autoMemoryRecallEnabled', 'voiceResponsesEnabled', 'preferredModel', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming()) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'email', 'themeMode', 'defaultStartupMode',
                         'voiceLanguage', 'responseStyle', 'waveformAnimationsEnabled',
                         'autoMemoryRecallEnabled', 'voiceResponsesEnabled', 'preferredModel', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /messages/{messageId} {
        allow list: if isOwner(userId);
        allow get, delete: if isOwner(userId) && isValidId(messageId);
        allow create: if isOwner(userId) &&
                         isValidId(messageId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'sessionId', 'role', 'text', 'latencyMs', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'sessionId', 'role', 'text', 'latencyMs', 'createdAt']) &&
                         isValidChatMessage(incoming()) &&
                         isValidTimestamp(incoming().createdAt);
        allow update: if false;
      }

      match /memories/{memoryId} {
        allow list: if isOwner(userId);
        allow get, delete: if isOwner(userId) && isValidId(memoryId);
        allow create: if isOwner(userId) &&
                         isValidId(memoryId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'category', 'key', 'value', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'category', 'key', 'value', 'createdAt', 'updatedAt']) &&
                         isValidMemoryFact(incoming()) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isValidTimestamp(incoming().updatedAt);
        allow update: if isOwner(userId) &&
                         isValidId(memoryId) &&
                         isValidMemoryFact(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['category', 'key', 'value', 'updatedAt']);
      }

      match /tasks/{taskId} {
        allow list: if isOwner(userId);
        allow get, delete: if isOwner(userId) && isValidId(taskId);
        allow create: if isOwner(userId) &&
                         isValidId(taskId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'title', 'description', 'priority', 'status', 'category', 'dueDateLabel', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'description', 'priority', 'status', 'category', 'dueDateLabel', 'createdAt', 'updatedAt']) &&
                         isValidPersonalTask(incoming()) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isValidTimestamp(incoming().updatedAt);
        allow update: if isOwner(userId) &&
                         isValidId(taskId) &&
                         isValidPersonalTask(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'priority', 'status', 'category', 'dueDateLabel', 'updatedAt']);
      }

      match /reminders/{reminderId} {
        allow list: if isOwner(userId);
        allow get, delete: if isOwner(userId) && isValidId(reminderId);
        allow create: if isOwner(userId) &&
                         isValidId(reminderId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'title', 'triggerLabel', 'recurringRule', 'status', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'triggerLabel', 'recurringRule', 'status', 'createdAt', 'updatedAt']) &&
                         isValidReminderItem(incoming()) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isValidTimestamp(incoming().updatedAt);
        allow update: if isOwner(userId) &&
                         isValidId(reminderId) &&
                         isValidReminderItem(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'triggerLabel', 'recurringRule', 'status', 'updatedAt']);
      }

      match /notes/{noteId} {
        allow list: if isOwner(userId);
        allow get, delete: if isOwner(userId) && isValidId(noteId);
        allow create: if isOwner(userId) &&
                         isValidId(noteId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'title', 'content', 'category', 'pinned', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'content', 'category', 'pinned', 'createdAt', 'updatedAt']) &&
                         isValidPersonalNote(incoming()) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isValidTimestamp(incoming().updatedAt);
        allow update: if isOwner(userId) &&
                         isValidId(noteId) &&
                         isValidPersonalNote(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'category', 'pinned', 'updatedAt']);
      }

      match /autonomous_runs/{runId} {
        allow list: if isOwner(userId);
        allow get, delete: if isOwner(userId) && isValidId(runId);
        allow create: if isOwner(userId) &&
                         isValidId(runId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'goal', 'status', 'stepsSummary', 'stepsCompleted', 'stepsTotal', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'goal', 'status', 'stepsSummary', 'stepsCompleted', 'stepsTotal', 'createdAt', 'updatedAt']) &&
                         isValidAutonomousRun(incoming()) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isValidTimestamp(incoming().updatedAt);
        allow update: if isOwner(userId) &&
                         isValidId(runId) &&
                         isValidAutonomousRun(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         !(existing().status in ['completed', 'failed', 'cancelled']) &&
                         isValidTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'stepsSummary', 'stepsCompleted', 'stepsTotal', 'updatedAt']);
      }

      match /permission_rules/{ruleId} {
        allow list: if isOwner(userId);
        allow get, delete: if isOwner(userId) && isValidId(ruleId);
        allow create: if isOwner(userId) &&
                         isValidId(ruleId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'permissionKey', 'decision', 'lifetime', 'reason', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'permissionKey', 'decision', 'lifetime', 'reason', 'createdAt', 'updatedAt']) &&
                         isValidPermissionRule(incoming()) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isValidTimestamp(incoming().updatedAt);
        allow update: if isOwner(userId) &&
                         isValidId(ruleId) &&
                         isValidPermissionRule(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['permissionKey', 'decision', 'lifetime', 'reason', 'updatedAt']);
      }

      match /audit_logs/{logId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(logId);
        allow create: if isOwner(userId) &&
                         isValidId(logId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'permissionKey', 'decision', 'reason', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'permissionKey', 'decision', 'reason', 'createdAt']) &&
                         isValidAuditEntry(incoming()) &&
                         isValidTimestamp(incoming().createdAt);
        allow update, delete: if false;
      }
    }
  }
}
